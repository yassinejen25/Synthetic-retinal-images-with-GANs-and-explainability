)\ndef load_raw(c):\n    im = cv2.cvtColor(cv2.imread(str(W / \"processed_raw\" / f\"{c}.png\")), cv2.COLOR_BGR2RGB)\n    im = cv2.resize(im, (RES, RES), interpolation=cv2.INTER_AREA)\n    return cv2.addWeighted(im, 4, cv2.GaussianBlur(im, (0, 0), 5), -4, 128)\nX = torch.from_numpy(np.stack([load_raw(c) for c in tr.id_code])).permute(0, 3, 1, 2).to(dev)\nY = torch.tensor(tr.diagnosis.values, device=dev)\nsamp_w = (1.0 / torch.bincount(Y, minlength=NC).float())[Y]      # class-balanced sampling\n\ndef real_batch():\n    idx = torch.multinomial(samp_w, BS, replacement=True)\n    x = X[idx].float() / 127.5 - 1\n    flip = torch.rand(BS, device=dev) < 0.5\n    return torch.where(flip[:, None, None, None], x.flip(3), x), Y[idx]\n\ndef diffaug(x):\n    B = x.size(0)\n    x = x + (torch.rand(B, 1, 1, 1, device=dev) - 0.5) * 0.2\n    th = torch.zeros(B, 2, 3, device=dev); th[:, 0, 0] = th[:, 1, 1] = 1\n    th[:, :, 2] = (torch.rand(B, 2, device=dev) - 0.5) * 0.1\n    return F.grid_sample(x, F.affine_grid(th, x.shape, align_corners=False), align_corners=False)\n\n# ---- generator: conditional BatchNorm carries the class label ----\nclass CBN(nn.Module):\n    def __init__(s, ch):\n        super().__init__(); s.bn = nn.BatchNorm2d(ch, affine=False)\n        s.g, s.b = nn.Embedding(NC, ch), nn.Embedding(NC, ch)\n        nn.init.ones_(s.g.weight); nn.init.zeros_(s.b.weight)\n    def forward(s, x, y): return s.bn(x) * s.g(y)[:, :, None, None] + s.b(y)[:, :, None, None]\n\nclass GBlock(nn.Module):\n    def __init__(s, i, o):\n        super().__init__(); s.n1, s.n2 = CBN(i), CBN(o)\n        s.c1, s.c2 = nn.Conv2d(i, o, 3, 1, 1), nn.Conv2d(o, o, 3, 1, 1)\n    def forward(s, x, y):\n        x = s.c1(F.relu(s.n1(F.interpolate(x, scale_factor=2), y)))\n        return s.c2(F.relu(s.n2(x, y)))\n\nclass G(nn.Module):\n    def __init__(s, chs=(512, 256, 256, 128, 64, 32)):\n        super().__init__(); s.fc = nn.Linear(ZD, 4 * 4 * chs[0])\n        s.blocks = nn.ModuleList([GBlock(chs[i], ch