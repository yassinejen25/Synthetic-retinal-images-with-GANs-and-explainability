pt = torch.optim.AdamW(model.parameters(), LR, weight_decay=1e-4)\n    sch = torch.optim.lr_scheduler.CosineAnnealingLR(opt, EPOCHS); scaler = torch.amp.GradScaler()\n\n    @torch.no_grad()\n    def predict(loader):\n        model.eval(); P, Yl = [], []\n        for x, y in loader:\n            with torch.autocast(\"cuda\"): P.append(torch.softmax(model(x.to(dev)), 1).float().cpu())\n            Yl.append(y)\n        return torch.cat(P).numpy(), torch.cat(Yl).numpy()\n\n    best, best_state = -1, None\n    for ep in range(EPOCHS):\n        model.train()\n        for x, y in tr_dl:\n            x, y = x.to(dev), y.to(dev); opt.zero_grad()\n            with torch.autocast(\"cuda\"): loss = crit(model(x), y)\n            scaler.scale(loss).backward(); scaler.step(opt); scaler.update()\n        sch.step()\n        p, yv = predict(va_dl); q = cohen_kappa_score(yv, p.argmax(1), weights=\"quadratic\")   # real val set picks the epoch\n        if q > best: best, best_state = q, {k: v.clone() for k, v in model.state_dict().items()}\n    model.load_state_dict(best_state)\n    p, yt = predict(te_dl); pred = p.argmax(1); cm = confusion_matrix(yt, pred, labels=range(5))\n    out = dict(config=\"real+synthetic\" if use_syn else \"real only\", seed=seed,\n               acc=accuracy_score(yt, pred), qwk=cohen_kappa_score(yt, pred, weights=\"quadratic\"),\n               auc=roc_auc_score(yt, p, multi_class=\"ovr\", average=\"macro\"))\n    for g_ in range(5): out[f\"sens_{g_}\"] = cm[g_, g_] / cm[g_].sum()\n    print(out[\"config\"], \"seed\", seed, \"| QWK\", round(out[\"qwk\"], 3)); return out\n\nres = pd.DataFrame([run(flag, sd) for sd in SEEDS for flag in (False, True)])\nres.to_csv(W / \"augmentation_results.csv\", index=False)\ncols = [\"acc\", \"qwk\", \"auc\"] + [f\"sens_{g}\" for g in range(5)]\nm, sd_ = res.groupby(\"config\")[cols].mean(), res.groupby(\"config\")[cols].std()\nprint((m.round(3).astype(str) + \" ± \" + sd_.round(3).astype(str)).T)\nprint(\"\\nDifference (